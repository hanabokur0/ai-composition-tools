import { useState, useMemo, useRef, useCallback, useEffect } from "react";

/* ─────────────────────────────────────────────
   GHR Image Analyzer v0
   Fixed: golden grid, weights, judgment bands
   Auto: FR estimation via saliency
   Output: Priority / Normal / Hold (→ CAG/IAD)
   ───────────────────────────────────────────── */

// ── constants (fixed, never changes) ────────
const PHI = 0.618033988749895;
const PHI_INV = 1 - PHI; // 0.381966...
const WEIGHTS = { fr: 0.40, sc: 0.25, nsr: 0.20, dl: 0.15 };
const OPTIMAL = { fr: 35, sc: 5, nsr: 25, dl: 3.5 };
const SIGMA = { fr: 10, sc: 2, nsr: 10, dl: 1.5 };
const BANDS = [
  { min: 70, label: "Priority", color: "#16a34a", bg: "#f0fdf4", border: "#bbf7d0", action: "使う", desc: "構図は黄金比に強く適合。そのまま使用可能。" },
  { min: 40, label: "Normal", color: "#d97706", bg: "#fffbeb", border: "#fde68a", action: "調整", desc: "部分的な調整で改善可能。" },
  { min: 0, label: "Hold", color: "#dc2626", bg: "#fef2f2", border: "#fecaca", action: "保留", desc: "構造的な再検討が必要。" },
];

// ── math ────────────────────────────────────
const gaussFit = (val, opt, sig) => Math.exp(-((val - opt) ** 2) / (2 * sig ** 2));

const calcGHR = (fr, sc, nsr, dl) => {
  const fits = {
    fr: gaussFit(fr, OPTIMAL.fr, SIGMA.fr),
    sc: gaussFit(sc, OPTIMAL.sc, SIGMA.sc),
    nsr: gaussFit(nsr, OPTIMAL.nsr, SIGMA.nsr),
    dl: gaussFit(dl, OPTIMAL.dl, SIGMA.dl),
  };
  const score = (WEIGHTS.fr * fits.fr + WEIGHTS.sc * fits.sc + WEIGHTS.nsr * fits.nsr + WEIGHTS.dl * fits.dl) * 100;
  return { score, fits };
};

const getBand = (score) => BANDS.find((b) => score >= b.min) || BANDS[2];

// ── saliency-based FR estimation ────────────
// Lightweight browser saliency: convert to grayscale, blur,
// threshold top-N% brightest region → area ratio = FR estimate
function estimateFR(imgEl, canvas) {
  const W = 200; // downsample for speed
  const aspect = imgEl.naturalHeight / imgEl.naturalWidth;
  const H = Math.round(W * aspect);

  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d", { willReadFrequently: true });
  ctx.drawImage(imgEl, 0, 0, W, H);

  const imgData = ctx.getImageData(0, 0, W, H);
  const px = imgData.data;
  const totalPixels = W * H;

  // 1. grayscale luminance
  const lum = new Float32Array(totalPixels);
  for (let i = 0; i < totalPixels; i++) {
    const off = i * 4;
    lum[i] = 0.299 * px[off] + 0.587 * px[off + 1] + 0.114 * px[off + 2];
  }

  // 2. simple box blur (3x3) for noise reduction
  const blurred = new Float32Array(totalPixels);
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      let sum = 0, count = 0;
      for (let dy = -1; dy <= 1; dy++) {
        for (let dx = -1; dx <= 1; dx++) {
          const ny = y + dy, nx = x + dx;
          if (ny >= 0 && ny < H && nx >= 0 && nx < W) {
            sum += lum[ny * W + nx];
            count++;
          }
        }
      }
      blurred[y * W + x] = sum / count;
    }
  }

  // 3. edge detection (Sobel-like gradient magnitude)
  const edges = new Float32Array(totalPixels);
  let maxEdge = 0;
  for (let y = 1; y < H - 1; y++) {
    for (let x = 1; x < W - 1; x++) {
      const gx = -blurred[(y - 1) * W + (x - 1)] + blurred[(y - 1) * W + (x + 1)]
               - 2 * blurred[y * W + (x - 1)] + 2 * blurred[y * W + (x + 1)]
               - blurred[(y + 1) * W + (x - 1)] + blurred[(y + 1) * W + (x + 1)];
      const gy = -blurred[(y - 1) * W + (x - 1)] - 2 * blurred[(y - 1) * W + x] - blurred[(y - 1) * W + (x + 1)]
               + blurred[(y + 1) * W + (x - 1)] + 2 * blurred[(y + 1) * W + x] + blurred[(y + 1) * W + (x + 1)];
      const mag = Math.sqrt(gx * gx + gy * gy);
      edges[y * W + x] = mag;
      if (mag > maxEdge) maxEdge = mag;
    }
  }

  // 4. combine: saliency = normalized_luminance_contrast + edge_strength
  // center-bias: pixels closer to center get a mild boost
  const cx = W / 2, cy = H / 2;
  const maxDist = Math.sqrt(cx * cx + cy * cy);
  const saliency = new Float32Array(totalPixels);
  let minS = Infinity, maxS = -Infinity;

  // luminance contrast: deviation from mean
  let meanLum = 0;
  for (let i = 0; i < totalPixels; i++) meanLum += blurred[i];
  meanLum /= totalPixels;

  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      const lumContrast = Math.abs(blurred[i] - meanLum) / 255;
      const edgeNorm = maxEdge > 0 ? edges[i] / maxEdge : 0;
      const dist = Math.sqrt((x - cx) ** 2 + (y - cy) ** 2);
      const centerBias = 1 - 0.3 * (dist / maxDist);
      const s = (0.5 * lumContrast + 0.5 * edgeNorm) * centerBias;
      saliency[i] = s;
      if (s < minS) minS = s;
      if (s > maxS) maxS = s;
    }
  }

  // 5. threshold: top 40% of saliency range → "salient" pixels
  const threshold = minS + (maxS - minS) * 0.6;
  let salientCount = 0;
  for (let i = 0; i < totalPixels; i++) {
    if (saliency[i] >= threshold) salientCount++;
  }

  const frEstimate = Math.round((salientCount / totalPixels) * 100);
  return Math.max(1, Math.min(99, frEstimate));
}

// ── components ──────────────────────────────

function ParamSlider({ label, tag, value, onChange, min, max, step, optimal, unit = "%", auto = false }) {
  return (
    <div className="mb-5">
      <div className="flex justify-between items-center mb-1.5">
        <div className="flex items-center gap-2">
          <span className="text-xs font-mono tracking-wide text-gray-500 uppercase">{tag}</span>
          <span className="text-sm text-gray-700">{label}</span>
          {auto && (
            <span className="text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700 font-medium">AUTO</span>
          )}
        </div>
        <span className="text-sm font-mono font-bold text-gray-900">{value}{unit}</span>
      </div>
      <div className="relative">
        <input
          type="range" min={min} max={max} step={step} value={value}
          onChange={(e) => onChange(parseFloat(e.target.value))}
          className="w-full h-1.5 rounded-full appearance-none cursor-pointer"
          style={{ background: `linear-gradient(to right, #a3a3a3 0%, #404040 ${((value - min) / (max - min)) * 100}%, #e5e5e5 ${((value - min) / (max - min)) * 100}%, #e5e5e5 100%)` }}
        />
        {optimal != null && (
          <div
            className="absolute top-0 w-px h-1.5 bg-amber-500"
            style={{ left: `${((optimal - min) / (max - min)) * 100}%` }}
          />
        )}
      </div>
      <div className="flex justify-between text-[10px] text-gray-400 mt-0.5">
        <span>{min}{unit}</span>
        {optimal != null && <span>optimal: {optimal}{unit}</span>}
        <span>{max}{unit}</span>
      </div>
    </div>
  );
}

function GoldenGrid({ show, corner = "SE", opacity = 0.8 }) {
  if (!show) return null;
  const p1 = `${PHI_INV * 100}%`;
  const p2 = `${PHI * 100}%`;
  const focusMap = { NW: [p1, p1], NE: [p2, p1], SW: [p1, p2], SE: [p2, p2] };
  const [fx, fy] = focusMap[corner] || focusMap.SE;

  return (
    <svg className="absolute inset-0 w-full h-full pointer-events-none" style={{ opacity }}>
      <line x1={p1} y1="0" x2={p1} y2="100%" stroke="#fbbf24" strokeWidth="1.5" strokeDasharray="6,4" />
      <line x1={p2} y1="0" x2={p2} y2="100%" stroke="#fbbf24" strokeWidth="1.5" strokeDasharray="6,4" />
      <line x1="0" y1={p1} x2="100%" y2={p1} stroke="#fbbf24" strokeWidth="1.5" strokeDasharray="6,4" />
      <line x1="0" y1={p2} x2="100%" y2={p2} stroke="#fbbf24" strokeWidth="1.5" strokeDasharray="6,4" />
      <circle cx={fx} cy={fy} r="6" fill="#fbbf24" opacity="0.85" />
      <circle cx={fx} cy={fy} r="14" fill="none" stroke="#fbbf24" strokeWidth="1" opacity="0.4" />
    </svg>
  );
}

function FitBar({ label, tag, value, weight }) {
  const pct = Math.round(value * 100);
  const barColor = pct >= 80 ? "#16a34a" : pct >= 50 ? "#d97706" : "#dc2626";
  return (
    <div className="mb-3">
      <div className="flex justify-between text-xs mb-1">
        <span className="text-gray-500 font-mono">{tag} <span className="text-gray-400">({weight}%)</span></span>
        <span className="font-mono font-bold" style={{ color: barColor }}>{pct}%</span>
      </div>
      <div className="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
        <div className="h-full rounded-full transition-all duration-500" style={{ width: `${pct}%`, backgroundColor: barColor }} />
      </div>
    </div>
  );
}

// ── main ────────────────────────────────────
export default function GHRAnalyzerV0() {
  const [image, setImage] = useState(null);
  const [imgSize, setImgSize] = useState(null);
  const [fr, setFr] = useState(35);
  const [frAuto, setFrAuto] = useState(null);
  const [sc, setSc] = useState(5);
  const [nsr, setNsr] = useState(25);
  const [dl, setDl] = useState(3.5);
  const [showGrid, setShowGrid] = useState(true);
  const [corner, setCorner] = useState("SE");
  const [gridOpacity, setGridOpacity] = useState(0.8);
  const [estimating, setEstimating] = useState(false);

  const fileRef = useRef(null);
  const imgRef = useRef(null);
  const canvasRef = useRef(null);

  const onUpload = useCallback((e) => {
    const file = e.target.files?.[0];
    if (!file || !/^image\//.test(file.type)) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      setImage(ev.target.result);
      setFrAuto(null);
    };
    reader.readAsDataURL(file);
  }, []);

  const onImgLoad = useCallback((e) => {
    const el = e.currentTarget;
    setImgSize({ w: el.naturalWidth, h: el.naturalHeight });

    // auto-estimate FR
    setEstimating(true);
    requestAnimationFrame(() => {
      try {
        const est = estimateFR(el, canvasRef.current);
        setFrAuto(est);
        setFr(est);
      } catch (err) {
        console.error("FR estimation failed:", err);
      }
      setEstimating(false);
    });
  }, []);

  const { score, fits } = useMemo(() => calcGHR(fr, sc, nsr, dl), [fr, sc, nsr, dl]);
  const band = useMemo(() => getBand(score), [score]);

  const improvements = useMemo(() => {
    const out = [];
    if (fr < 25) out.push("FR低: 主役が小さすぎる → 30–37%を目指す");
    if (fr > 45) out.push("FR高: 主役が大きすぎる → 圧迫感を下げる");
    if (sc < 3) out.push("SC低: 副要素を追加して視線誘導を作る");
    if (sc > 7) out.push("SC高: 副要素を削減して焦点を明確化");
    if (nsr < 15) out.push("NSR低: 余白不足 → ネガティブスペースを増やす");
    if (nsr > 35) out.push("NSR高: 余白過多 → 意味のある要素を加える");
    if (dl < 2.5) out.push("DL低: 奥行きを追加して3層以上に");
    if (dl > 4.5) out.push("DL高: 階層過多 → 3–4層に集約");
    return out;
  }, [fr, sc, nsr, dl]);

  return (
    <div className="min-h-screen bg-neutral-50" style={{ fontFamily: "'IBM Plex Sans', 'Noto Sans JP', system-ui, sans-serif" }}>
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
      <canvas ref={canvasRef} className="hidden" />

      {/* header */}
      <header className="border-b border-gray-200 bg-white">
        <div className="max-w-7xl mx-auto px-4 py-4 flex items-baseline gap-3">
          <h1 className="text-xl font-bold tracking-tight text-gray-900" style={{ fontFamily: "'IBM Plex Mono', monospace" }}>
            GHR<span className="text-gray-400 font-normal">/v0</span>
          </h1>
          <span className="text-xs text-gray-400">Golden Harmony Ratio — Fixed Geometry + Auto FR</span>
        </div>
      </header>

      <div className="max-w-7xl mx-auto px-4 py-6">
        <div className="grid lg:grid-cols-12 gap-6">

          {/* ── left: image ── */}
          <div className="lg:col-span-7 space-y-4">
            <div className="bg-white rounded-lg border border-gray-200 overflow-hidden">
              {!image ? (
                <div
                  onClick={() => fileRef.current?.click()}
                  className="p-16 text-center cursor-pointer hover:bg-gray-50 transition"
                >
                  <div className="w-12 h-12 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="#9ca3af" strokeWidth="2" strokeLinecap="round"/></svg>
                  </div>
                  <p className="text-sm text-gray-500 mb-1">画像をアップロード</p>
                  <p className="text-xs text-gray-400">JPG / PNG / WebP</p>
                </div>
              ) : (
                <div className="relative">
                  <img ref={imgRef} src={image} alt="target" onLoad={onImgLoad} className="w-full block" />
                  <GoldenGrid show={showGrid} corner={corner} opacity={gridOpacity} />
                  {estimating && (
                    <div className="absolute inset-0 bg-black/30 flex items-center justify-center">
                      <span className="text-white text-sm font-mono animate-pulse">FR推定中...</span>
                    </div>
                  )}
                </div>
              )}
              <input ref={fileRef} type="file" accept="image/*" onChange={onUpload} className="hidden" />
            </div>

            {image && (
              <div className="flex flex-wrap items-center gap-3 text-xs">
                <button onClick={() => setShowGrid((v) => !v)}
                  className={`px-3 py-1.5 rounded border font-medium transition ${showGrid ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-600 border-gray-300"}`}
                >Grid {showGrid ? "ON" : "OFF"}</button>

                <div className="flex border border-gray-300 rounded overflow-hidden">
                  {["NW", "NE", "SW", "SE"].map((c) => (
                    <button key={c} onClick={() => setCorner(c)}
                      className={`px-2.5 py-1.5 font-mono text-xs transition ${corner === c ? "bg-gray-900 text-white" : "bg-white text-gray-600 hover:bg-gray-50"}`}
                    >{c}</button>
                  ))}
                </div>

                <div className="flex items-center gap-2 text-gray-500">
                  <span>透明度</span>
                  <input type="range" min={0.1} max={1} step={0.05} value={gridOpacity}
                    onChange={(e) => setGridOpacity(parseFloat(e.target.value))}
                    className="w-20 h-1 appearance-none bg-gray-300 rounded cursor-pointer"
                  />
                </div>

                <button onClick={() => fileRef.current?.click()}
                  className="px-3 py-1.5 rounded border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 font-medium"
                >変更</button>

                {imgSize && (
                  <span className="text-gray-400 font-mono">{imgSize.w}×{imgSize.h}</span>
                )}
              </div>
            )}
          </div>

          {/* ── right: controls + score ── */}
          <div className="lg:col-span-5 space-y-4">

            {/* judgment band */}
            <div className="rounded-lg border-2 p-5 text-center transition-all duration-300"
              style={{ borderColor: band.border, backgroundColor: band.bg }}>
              <div className="text-5xl font-bold font-mono tracking-tight mb-1" style={{ color: band.color, fontFamily: "'IBM Plex Mono', monospace" }}>
                {score.toFixed(1)}
              </div>
              <div className="flex items-center justify-center gap-2 mb-2">
                <span className="text-lg font-bold" style={{ color: band.color }}>{band.label}</span>
                <span className="text-xs px-2 py-0.5 rounded-full font-medium" style={{ backgroundColor: band.color, color: "white" }}>
                  {band.action}
                </span>
              </div>
              <p className="text-xs text-gray-500">{band.desc}</p>

              {/* pipeline hint */}
              <div className="mt-3 pt-3 border-t text-[10px] text-gray-400 font-mono" style={{ borderColor: band.border }}>
                GHR → <span style={{ color: band.color }}>{band.label}</span> → CAG/IAD
              </div>
            </div>

            {/* fit bars */}
            <div className="bg-white rounded-lg border border-gray-200 p-4">
              <h3 className="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Fit Analysis</h3>
              <FitBar label="Focal Ratio" tag="FR" value={fits.fr} weight={40} />
              <FitBar label="Sub-elements" tag="SC" value={fits.sc} weight={25} />
              <FitBar label="Negative Space" tag="NSR" value={fits.nsr} weight={20} />
              <FitBar label="Depth Layers" tag="DL" value={fits.dl} weight={15} />
            </div>

            {/* parameters */}
            <div className="bg-white rounded-lg border border-gray-200 p-4">
              <h3 className="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Parameters</h3>

              <ParamSlider label="主役率" tag="FR" value={fr} onChange={setFr}
                min={0} max={100} step={1} optimal={35} auto={frAuto !== null} />

              {frAuto !== null && fr !== frAuto && (
                <div className="mb-4 -mt-2">
                  <button onClick={() => setFr(frAuto)}
                    className="text-[10px] text-emerald-600 hover:text-emerald-700 font-medium">
                    ↩ 自動推定値に戻す ({frAuto}%)
                  </button>
                </div>
              )}

              <ParamSlider label="副要素数" tag="SC" value={sc} onChange={setSc}
                min={0} max={15} step={1} optimal={5} unit="個" />
              <ParamSlider label="余白率" tag="NSR" value={nsr} onChange={setNsr}
                min={0} max={100} step={1} optimal={25} />
              <ParamSlider label="奥行き層" tag="DL" value={dl} onChange={setDl}
                min={1} max={6} step={0.5} optimal={3.5} unit="層" />
            </div>

            {/* improvements */}
            {improvements.length > 0 && (
              <div className="bg-white rounded-lg border border-gray-200 p-4">
                <h3 className="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Adjustments</h3>
                {improvements.map((text, i) => (
                  <div key={i} className="text-xs text-gray-600 py-1.5 border-b border-gray-100 last:border-0 font-mono">
                    {text}
                  </div>
                ))}
              </div>
            )}

            {/* fixed spec */}
            <div className="text-[10px] text-gray-400 font-mono leading-relaxed px-1">
              <div className="mb-1 text-gray-500 font-bold">Fixed Spec</div>
              <div>φ = {PHI.toFixed(12)}</div>
              <div>grid = {(PHI_INV * 100).toFixed(2)}% / {(PHI * 100).toFixed(2)}%</div>
              <div>weights = FR:{WEIGHTS.fr} SC:{WEIGHTS.sc} NSR:{WEIGHTS.nsr} DL:{WEIGHTS.dl}</div>
              <div>bands = Priority(≥70) Normal(≥40) Hold(&lt;40)</div>
              <div>fit = exp(-(x-μ)²/2σ²)</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
